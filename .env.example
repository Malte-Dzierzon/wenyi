# Provider API keys. Only the providers selected in config need credentials.
# Keys are also accepted from the OS credential store (Desktop) — env vars win.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ORCAROUTER_API_KEY=
# Custom providers: add the variable named by llm.providers.<name>.api_key_env.

# MinerU is used only for PDF input with pipeline.pdf_backend: mineru.
MINERU_API_KEY=

# Local Desktop development.
DATA_DIR=./data
WENYI_CONFIG=config.yaml
